 	vmx_complete_interrupts(vmx);
 
+	/*
+	 * QD-TSC: Schuld graduell zurueckzahlen (nur auf Nicht-CPUID-Exits,
+	 * CPUID-Exits verzweigen unten vorher in den Short-Circuit). Ohne
+	 * Payback bleibt der Diebstahl bis zum Cap stehen (bis ~50 ms pro
+	 * vCPU) und bringt Windows-User-Services via TSC-Inkonsistenz zum
+	 * Absturz (Clipboard/CDP/PushNotifications, Eventlog 7031/7009).
+	 * Mit Payback begrenzt sich der stehende Drift auf Mikrosekunden
+	 * und heilt nach einer Probe in Sekunden ab.
+	 */
+	if (vmx->qd_ts1 &&
+	    vmx_get_exit_reason(vcpu).basic != EXIT_REASON_CPUID &&
+	    vmx_get_exit_reason(vcpu).basic != EXIT_REASON_RDTSC &&
+	    vmx_get_exit_reason(vcpu).basic != EXIT_REASON_RDTSCP) {
+		u64 qd_pay = min_t(u64, vmx->qd_ts1, 1000);
+
+		vmx->qd_ts1 -= qd_pay;
+		vcpu->arch.l1_tsc_offset += (s64)qd_pay;
+		vcpu->arch.tsc_offset = vcpu->arch.l1_tsc_offset;
+		vmx_write_tsc_offset(vcpu);
+	}
+
+	/*
+	 * QD-DEEP: CPUID-Short-Circuit — den Exit komplett hier abarbeiten
+	 * und per goto direkt zum VMENTER zurueckspringen: keine C-Rueckkehr
+	 * nach vcpu_enter_guest, kein Loop-Top (Requests/Injection/sync_pir),
+	 * kein erneuter vmx_vcpu_run-Prolog (trace/ple/nested-Warn).
+	 * Wiederholt werden nur die essenziellen Pre-VMENTER-Schritte ab
+	 * qd_reenter (RIP/RSP-Flush, xsave, hv_timer, lapic-align).
+	 * Gates identisch zum 0006-Fastpath; QD_SC_MAX begrenzt aufeinander-
+	 * folgende Short-Circuits (Event-Deferral), danach ein normaler
+	 * REENTER-Durchlauf durch den Loop-Top.
+	 */
+	if (!is_guest_mode(vcpu) &&
+	    vmx_get_exit_reason(vcpu).basic == EXIT_REASON_CPUID &&
+	    !(vcpu->guest_debug & KVM_GUESTDBG_SINGLESTEP) &&
+	    !(vmx_get_rflags(vcpu) & X86_EFLAGS_TF) &&
+	    !(vcpu->arch.msr_misc_features_enables &
+	      MSR_MISC_FEATURES_ENABLES_CPUID_FAULT)) {
+		int r = kvm_emulate_cpuid(vcpu);
+
+		if (r == 1) {
+			if (++vmx->qd_n < QD_SC_MAX)
+				goto qd_reenter;
+			vmx->qd_n = 0;
+			return EXIT_FASTPATH_REENTER_GUEST;
+		}
+
+		pr_warn_ratelimited("kvm: CPUID short-circuit unexpected r=%d\n", r);
+	}
+
+	/*
+	 * QD-RDTSC (0009): RDTSC/RDTSCP-Short-Circuit — der Rueckgabewert
+	 * wurde oben am fruehesten Capture-Punkt kompensiert und gestasht;
+	 * hier nur noch Register schreiben, RIP erhoehen und wie der
+	 * CPUID-Short-Circuit direkt zum VMENTER zurueckspringen (kein
+	 * Loop-Top, kein Exit-Dispatch, kein vcpu_enter_guest-Rundlauf).
+	 */
+	if (qd_rdtsc_exit && !vmx->fail && !is_guest_mode(vcpu) &&
+	    !(vcpu->guest_debug & KVM_GUESTDBG_SINGLESTEP) &&
+	    !(vmx_get_rflags(vcpu) & X86_EFLAGS_TF) &&
+	    (vmx_get_exit_reason(vcpu).basic == EXIT_REASON_RDTSC ||
+	     vmx_get_exit_reason(vcpu).basic == EXIT_REASON_RDTSCP)) {
+		bool qd_rp = vmx->qd_tsc_rdtscp;
+
+		kvm_register_write(vcpu, VCPU_REGS_RAX, (u32)vmx->qd_tsc_val);
+		kvm_register_write(vcpu, VCPU_REGS_RDX, vmx->qd_tsc_val >> 32);
+		if (qd_rp) {
+			u32 qd_aux;
+
+			rdmsrl(MSR_TSC_AUX, qd_aux);
+			kvm_register_write(vcpu, VCPU_REGS_RCX, qd_aux);
+		}
+		vmx_set_interrupt_shadow(vcpu, 0);
+		kvm_rip_write(vcpu, kvm_rip_read(vcpu) + (qd_rp ? 3 : 2));
+		vmx->qd_tsc_valid = 0;
+
+		if (++vmx->qd_n < QD_SC_MAX)
+			goto qd_reenter;
+		vmx->qd_n = 0;
+		return EXIT_FASTPATH_REENTER_GUEST;
+	}
+	vmx->qd_n = 0;
+
 	return vmx_exit_handlers_fastpath(vcpu, force_immediate_exit);
 }
 
