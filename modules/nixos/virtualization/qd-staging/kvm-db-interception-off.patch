+	/*
+	 * QemuDetection: #DB nur intercepten, wenn Gast-Debugging aktiv ist.
+	 * Bare Metal liefert #DB nativ an den Gast-IDT; KVMs bedingungslose
+	 * #DB-VM-Exits erzeugen eine messbare Ausnahme-Latenz gegenueber
+	 * reinen Syscalls (VMAware VM::TIMER exception_ratio: #DB vs.
+	 * ZwRaiseException). Native Delivery ist bare-metal-identisch und
+	 * schliesst diesen Seitenkanal. Muss vor dem Nested-OR stehen,
+	 * damit L1-Intercept-Wuensche weiterhin respektiert werden.
+	 */
+	if (!(vcpu->guest_debug & KVM_GUESTDBG_ENABLE))
+		eb &= ~(1u << DB_VECTOR);
+
